FROM node:22-alpine AS deps

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.25.0 --activate

COPY package.json ./
RUN node -e "const fs = require('node:fs'); const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8')); delete pkg.packageManager; delete pkg.dependencies; delete pkg.devDependencies; delete pkg.scripts; pkg.workspaces.packages = ['apps/server', 'apps/web', 'packages/api', 'packages/auth', 'packages/config', 'packages/db', 'packages/env', 'packages/infra', 'packages/ui']; delete pkg.workspaces.catalog; pkg.pnpm = { onlyBuiltDependencies: ['esbuild', 'msw', 'sharp', 'workerd'] }; fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\\n');"
RUN printf '%s\n' 'packages:' '  - apps/server' '  - apps/web' '  - packages/api' '  - packages/auth' '  - packages/config' '  - packages/db' '  - packages/env' '  - packages/infra' '  - packages/ui' 'catalog:' '  dotenv: ^17.2.2' '  zod: ^4.1.13' '  typescript: ^6' "  '@types/bun': ^1.3.4" '  hono: ^4.8.2' "  '@orpc/server': ^1.13.14" "  '@orpc/openapi': ^1.13.14" "  '@orpc/zod': ^1.13.14" '  better-auth: 1.6.9' '  next-themes: ^0.4.6' "  '@orpc/client': ^1.13.14" "  '@types/react-dom': ^19.2.3" '  alchemy: ^0.91.2' > pnpm-workspace.yaml
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/api/package.json packages/api/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/env/package.json packages/env/package.json
COPY packages/infra/package.json packages/infra/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN node -e "const fs = require('node:fs'); for (const file of ['apps/server/package.json', 'apps/web/package.json']) { const pkg = JSON.parse(fs.readFileSync(file, 'utf8')); if (pkg.devDependencies) { delete pkg.devDependencies.void; delete pkg.devDependencies['@void/react']; } fs.writeFileSync(file, JSON.stringify(pkg, null, 2) + '\n'); }"

RUN pnpm install

FROM oven/bun:1.3.2 AS build

WORKDIR /app

ARG VITE_SERVER_URL=http://localhost:3000
ARG VITE_SITE_URL=http://localhost:3001

ENV VITE_SERVER_URL=$VITE_SERVER_URL
ENV VITE_SITE_URL=$VITE_SITE_URL

COPY --from=deps /app ./
COPY . .

RUN bun run --filter web build

FROM oven/bun:1.3.2 AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/package.json /app/bun.lock ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps ./apps
COPY --from=build /app/packages ./packages

EXPOSE 3001

CMD ["bun", "run", "--filter", "web", "serve", "--", "--host", "0.0.0.0", "--port", "3001"]
