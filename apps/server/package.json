{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test src/trends/__tests__",
    "void": "void"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.46",
    "@opentrends/api": "workspace:*",
    "@opentrends/auth": "workspace:*",
    "@opentrends/db": "workspace:*",
    "@opentrends/env": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "ai": "^6.0.175",
    "better-auth": "catalog:",
    "cheerio": "^1.2.0",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "hono": "catalog:",
    "rss-parser": "^3.13.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opentrends/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.21.9",
    "typescript": "catalog:",
    "vite": "^8.0.8",
    "void": "0.7.1"
  }
}
