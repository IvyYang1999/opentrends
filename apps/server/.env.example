# PostgreSQL connection string used by Drizzle and the server runtime.
DATABASE_URL=postgresql://postgres:password@localhost:5434/opentrends

# Better-Auth secret — must be at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the auth server (the API host).
BETTER_AUTH_URL=http://localhost:3000

# Origin allowed by CORS — typically the web app URL.
CORS_ORIGIN=http://localhost:3001

# Optional comma/newline-separated RSSHub instances. When unset, the built-in
# public failover list below is used.
# Bare hostnames are treated as https:// hosts.
# For a local RSSHub dev stack, include http://localhost:1200 first.
# RSSHUB_BASE_URLS=rss.datuan.dev,rss.4040940.xyz,rsshub.cups.moe,rss.spriple.org,rsshub-balancer.virworks.moe,rsshub.umzzz.com,rsshub.isrss.com

# Runtime mode. One of: development | production | test. Defaults to development.
# NODE_ENV=development

# LLM provider credentials used by the trends summary service.
# LLM_API_KEY is optional — when missing, summary generation is disabled.
LLM_API_KEY=
# LLM_BASE_URL=https://dashboard.thorbase.com/v1
# LLM_MODEL=deepseek/deepseek-v4-pro

# Background source refresh scheduler. "auto" enables it in production only.
# Use "enabled" to force it on, or "disabled" to force it off.
# TRENDS_REFRESH_SCHEDULER=auto
