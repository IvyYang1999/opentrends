# URL of the backend API server. Required.
# In production this must be the deployed apps/server origin, not the web origin.
VITE_SERVER_URL=http://localhost:3000

# Public site URL used for canonical links, OpenGraph metadata, and sitemap.xml generation.
# Optional in development; set to the production origin (without trailing slash) when deploying.
VITE_SITE_URL=http://localhost:3001
# VITE_SITE_URL=https://opentrends.example.com

# Optional comma- or space-separated locale codes exposed by the UI, SEO alternates, and sitemap.
# Supported values: en, zh, zh-Hant, ru. Unknown values are ignored; en remains the default locale.
# VITE_SUPPORTED_LOCALES=en,zh,zh-Hant,ru
